# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.crt
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
# FTP/SFTP client settings may contain server passwords.
sftp-config.json
.ftpconfig
*.ftp.json

# ---------------------------------------------------------------------------
# Personal data: local portfolio databases and backups
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
holdr-backup*.json

# ---------------------------------------------------------------------------
